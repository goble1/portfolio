---
import SunIcon from './icons/SunIcon.astro';
import MoonIcon from './icons/MoonIcon.astro';

const base = import.meta.env.BASE_URL;

const navItems = [
  { name: "About Me", href: base },
  { name: "Visualizations", href: `${base}visualizations` },
  { name: "Resume", href: `${base}resume` },
  { name: "Blog", href: `${base}blog` },
];
---

<header class="bg-gray-900 text-white shadow-md sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
    <h1 class="text-lg font-semibold tracking-wide">Craig Goble</h1>
    <div class="flex items-center gap-6">
      <ul class="flex gap-6 text-sm font-medium list-none m-0 p-0">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="hover:text-blue-400 transition-colors duration-200"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
      <button
        class="w-8 h-8 p-1 rounded hover:bg-gray-800 transition"
        aria-label="Toggle Dark Mode"
        onclick="
          const html = document.documentElement;
          const isDark = html.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');

          const sun = document.getElementById('sun');
          const moon = document.getElementById('moon');
          
          sun.classList.toggle('hidden', isDark);
          moon.classList.toggle('hidden', !isDark);

          const icon = isDark ? moon : sun;
          icon.classList.add('scale-90', 'rotate-12');
          setTimeout(() => icon.classList.remove('scale-90', 'rotate-12'), 300);
        "
      >
        <span id="sun" class="block dark:hidden">
          <SunIcon />
        </span>
        <span id="moon" class="hidden dark:block">
          <MoonIcon />
        </span>
      </button>
      </button>
    </div>
  </nav>
</header>

