---
import Header from '../components/Header.astro';
const { title = "Craig Goble" } = Astro.props;

// Use import.meta.env.BASE_URL to get the base URL
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script>
      // Adds/removes the `dark` class based on localStorage or system setting
      if (
        localStorage.getItem("theme") === "dark" ||
        (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <link rel="stylesheet" href={`${base}assets/_slug_.F5P_0dVk.css`} />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    <Header />
    <main class="px-4 py-8">
      <slot />
    </main>
  </body>
</html>


