---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Blog">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-blue-600 dark:text-blue-400 mb-8 text-center">Blog</h1>

    <div class="space-y-8">
      {posts.map((post) => (
        <a
          href={`${base}blog/${post.slug}`}
          class="block p-6 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow hover:shadow-lg transition-shadow duration-300"
        >
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-1">{post.data.title}</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">{post.data.pubDate}</p>
          <p class="mt-2 text-gray-700 dark:text-gray-300">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

