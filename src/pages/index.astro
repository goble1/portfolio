---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<!-- deploy test: added this comment at {new Date().toISOString()} -->
<BaseLayout title="About Me">
  <section class="min-h-[80vh] flex flex-col justify-center items-center text-center px-4">
    <h1 class="text-5xl font-bold text-blue-600 mb-4">Craig Goble</h1>
    <p class="text-lg text-gray-700 max-w-xl">
      I'm a Site Reliability Engineer and Marine Corps veteran. I specialize in cloud infrastructure, automation, and bringing creative projects to life with code — from p5.js visualizations to fully scalable DevOps pipelines.
    </p>
    <div class="mt-6 flex gap-4">
      <a href="/resume" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">
        View Resume
      </a>
      <a href="/blog" class="px-4 py-2 border border-blue-600 text-blue-600 rounded hover:bg-blue-100 transition">
        Read Blog
      </a>
    </div>
  </section>
</BaseLayout>
